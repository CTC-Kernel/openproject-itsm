<%# Styles du tableau de bord ITSM, scopés .op-itsm-*.
    Basés sur les variables Primer livrées avec OpenProject (thèmes clair/sombre),
    avec repli sur des couleurs à contraste renforcé. %>
<style nonce="<%= content_security_policy_nonce %>">
  .op-itsm-kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin: 16px 0 24px;
  }
  .op-itsm-kpi {
    border: 1px solid var(--borderColor-default, #d1d9e0);
    border-top: 4px solid var(--borderColor-default, #d1d9e0);
    border-radius: 10px;
    padding: 14px 16px;
    background: var(--bgColor-default, #fff);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .op-itsm-kpi--value { font-size: 1.9rem; font-weight: 700; line-height: 1.1; }
  .op-itsm-kpi--label { color: var(--fgColor-muted, #424a53); font-size: 0.82rem; }
  .op-itsm-kpi.-danger    { border-top-color: var(--fgColor-danger, #a0111f); }
  .op-itsm-kpi.-danger .op-itsm-kpi--value    { color: var(--fgColor-danger, #a0111f); }
  .op-itsm-kpi.-attention { border-top-color: var(--fgColor-attention, #7d4e00); }
  .op-itsm-kpi.-attention .op-itsm-kpi--value { color: var(--fgColor-attention, #7d4e00); }
  .op-itsm-kpi.-success   { border-top-color: var(--fgColor-success, #116329); }
  .op-itsm-kpi.-success .op-itsm-kpi--value   { color: var(--fgColor-success, #116329); }

  .op-itsm-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 8px;
  }
  .op-itsm-panel {
    border: 1px solid var(--borderColor-default, #d1d9e0);
    border-radius: 10px;
    padding: 16px;
    background: var(--bgColor-default, #fff);
  }
  .op-itsm-panel h3 { margin: 0 0 12px; font-size: 1rem; }
  .op-itsm-row {
    display: flex; align-items: center; gap: 10px;
    padding: 6px 0;
  }
  .op-itsm-row--label { flex: 0 0 9em; }
  .op-itsm-row--count { flex: 0 0 2.5em; text-align: right; font-weight: 600; }
  .op-itsm-bar {
    flex: 1; height: 8px; border-radius: 4px; overflow: hidden;
    background: var(--bgColor-neutral-muted, #eff2f5);
  }
  .op-itsm-bar > span { display: block; height: 100%;
    background: var(--bgColor-accent-emphasis, #0969da); }

  .op-itsm-badge {
    display: inline-block; padding: 1px 10px; border-radius: 999px;
    font-size: 0.75rem; font-weight: 600; white-space: nowrap;
    border: 1px solid var(--borderColor-default, #d1d9e0);
  }
  .op-itsm-badge.-p1 { background: var(--bgColor-danger-muted, #ffebe9);
    color: var(--fgColor-danger, #a0111f); }
  .op-itsm-badge.-p2 { background: var(--bgColor-severe-muted, #fff1e5);
    color: var(--fgColor-severe, #873800); }
  .op-itsm-badge.-p3 { background: var(--bgColor-attention-muted, #fff8c5);
    color: var(--fgColor-attention, #7d4e00); }
  .op-itsm-badge.-p4 { background: var(--bgColor-neutral-muted, #eff2f5);
    color: var(--fgColor-muted, #424a53); }

  .op-itsm-due { white-space: nowrap; }
  .op-itsm-due.-overdue { color: var(--fgColor-danger, #a0111f); font-weight: 600; }
  .op-itsm-paused { color: var(--fgColor-muted, #424a53); white-space: nowrap; }

  .op-itsm-h {
    margin: 28px 0 10px; font-size: 1.05rem;
    display: flex; align-items: center; gap: 8px;
  }
  .op-itsm-h .op-itsm-count-pill {
    font-size: 0.78rem; font-weight: 600; padding: 0 8px; border-radius: 999px;
    background: var(--bgColor-neutral-muted, #eff2f5);
    color: var(--fgColor-muted, #424a53);
  }
  .op-itsm-h.-danger .op-itsm-count-pill {
    background: var(--bgColor-danger-muted, #ffebe9);
    color: var(--fgColor-danger, #a0111f);
  }

  .op-itsm-empty {
    border: 1px dashed var(--borderColor-default, #d1d9e0);
    border-radius: 10px; padding: 24px; text-align: center;
    color: var(--fgColor-muted, #424a53);
  }
</style>
