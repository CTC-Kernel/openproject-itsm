<% html_title t("itsm.sla_policies.new"), @project.name %>
<%= render partial: "itsm/shared/page_header",
           locals: { title: t("itsm.sla_policies.new"), project: @project } %>

<%= form_for @policy,
             as: :itsm_sla_policy,
             url: itsm_sla_policies_path(@project),
             html: { class: "form" } do |f| %>
  <%= render partial: "itsm/sla_policies/form", locals: { f: f } %>
  <%= styled_button_tag t(:button_create), class: "-primary" %>
  <%= link_to t(:button_cancel), itsm_sla_policies_path(@project), class: "button" %>
<% end %>
